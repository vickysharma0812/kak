+/// Anything with a tree-sitter byte range: a node, or a [`Span`] over several nodes.
+pub trait ByteRange {
+  fn start_byte(&self) -> u32;
+  fn end_byte(&self) -> u32;
+}
+
+impl ByteRange for Node<'_> {
+  fn start_byte(&self) -> u32 {
+    Node::start_byte(self)
+  }
+
+  fn end_byte(&self) -> u32 {
+    Node::end_byte(self)
+  }
+}
+
+/// Byte range of a text-object capture. A quantified capture such as
+/// `(_)+ @function.inside` matches several sibling nodes; the span covers them
+/// all, from the start of the first to the end of the last (as Helix does).
+#[derive(Clone, Copy, Debug)]
+pub struct Span {
+  pub start: u32,
+  pub end: u32,
+}
+
+impl ByteRange for Span {
+  fn start_byte(&self) -> u32 {
+    self.start
+  }
+
+  fn end_byte(&self) -> u32 {
+    self.end
+  }
+}
+
