+  ///
+  /// tree-sitter ends are exclusive. Converting the end and then stepping back a
+  /// column breaks when a node ends at a line start (e.g. after the newline of
+  /// `end subroutine`): that yields column 0, which Kakoune rejects. Converting
+  /// the last byte instead selects up to and including that newline.
+  pub fn from_tree_sitter_end(buf: RopeSlice, start_byte: u32, end_byte: u32) -> Self {
+    Self::from_tree_sitter(buf, end_byte.saturating_sub(1).max(start_byte))
+  }
