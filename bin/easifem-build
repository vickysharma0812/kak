#!/usr/bin/env bash
# Build and install an easifem package in the background, then report to
# Kakoune (and as a macOS notification). With "install", skip the build step.
# usage: easifem-build <session> <client> <pkg> [install]
# The full output goes to ~/.cache/easifem/easifem-build-<pkg>-log.txt.

session=$1 client=$2 pkg=$3 mode=${4:-build}
logdir=${XDG_CACHE_HOME:-$HOME/.cache}/easifem
log=$logdir/easifem-build-$pkg-log.txt
pidfile=$logdir/easifem-build-$pkg.pid
mkdir -p "$logdir"

# Quote a string for Kakoune ('...' with doubled single quotes).
kq() { local q="'"; printf "'%s'" "${1//$q/$q$q}"; }
send() { printf 'evaluate-commands -try-client %s -- %s\n' "$client" "$(kq "$1")" | kak -p "$session"; }
# notify() { osascript -e "display notification \"$1\" with title \"easifem\"" >/dev/null 2>&1; }
notify() {
    if command -v osascript >/dev/null; then
        osascript -e "display notification \"$1\" with title \"easifem\"" >/dev/null 2>&1
    else
        notify-send easifem "$1" >/dev/null 2>&1
    fi
}

if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
    send "echo -markup {Error}easifem: $pkg is already building or installing"
    exit 0
fi
echo $$ >"$pidfile"
trap 'rm -f "$pidfile"' EXIT

start=$(date +%s)
{
    if [ "$mode" = install ]; then
        echo "# easifem install $pkg --no-download  ($(date '+%Y-%m-%d %H:%M:%S'))"
        easifem install "$pkg" --no-download --verbose
    else
        echo "# easifem dev $pkg && easifem install $pkg --no-download  ($(date '+%Y-%m-%d %H:%M:%S'))"
        easifem dev "$pkg" --verbose && easifem install "$pkg" --no-download --verbose
    fi
} >"$log" 2>&1
status=$?
secs=$(($(date +%s) - start))
took="$((secs / 60))m $((secs % 60))s"
echo "# finished: exit $status ($took)" >>"$log"

if [ $status -eq 0 ]; then
    if [ "$mode" = install ]; then done=installed; else done="built and installed"; fi
    send "info -title easifem $(kq "$pkg: $done ($took)")"
    notify "$pkg: $done ($took)"
else
    # Show the first compiler errors (file name only), or the end of the log.
    errors=$("$(dirname "$0")/easifem-errors" "$log")
    if [ -n "$errors" ]; then
        n=$(printf '%s\n' "$errors" | wc -l | tr -d ' ')
        body=$(printf '%s\n' "$errors" | head -n 6 | sed 's|^.*/||')
        title="easifem: $pkg FAILED, $n error(s) ($took)"
    else
        body=$(tail -n 8 "$log")
        title="easifem: $pkg FAILED (exit $status, $took)"
    fi
    send "info -title $(kq "$title") $(kq "$body

<space>+ e lists the errors, <space>+ l opens the log")"
    notify "$pkg: $mode FAILED, <space>+ e lists the errors"
fi
